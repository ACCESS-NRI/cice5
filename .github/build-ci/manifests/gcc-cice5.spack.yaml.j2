spack:
  specs:
  - 'cice5@git.{{ ref }}=stable model=access-om2'
  - 'cice5@git.{{ ref }}=stable build_system=cmake model=access-om2 nxglob=360 nyglob=300 blckx=15 blcky=300 mxblcks=1'
  - 'cice5@git.{{ ref }}=stable build_type=Debug build_system=cmake model=access-om2 nxglob=360 nyglob=300 blckx=15 blcky=300 mxblcks=1'
  packages:
    all:
      require:
      - '%{{ gcc_compiler }}'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false