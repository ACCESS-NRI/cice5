spack:
  specs:
  - 'cice5@git.{{ ref }}=stable {{ om2_2deg }}'
  - 'cice5@git.{{ ref }}=stable model=access-om2'
  packages:
    gcc:
      require:
      - '{{ gcc_compiler_ver }}'
    all:
      require:
      - '%access_gcc'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false
