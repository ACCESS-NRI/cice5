spack:
  include:
  # Include configuration from this repository, with the environment variable defined in build-ci
  - path: $SPACK_MANIFEST_REPOSITORY_PATH/.github/build-ci/config
  specs:
  - 'cice5@git.{{ ref }}=stable build_system=cmake model=access-om2 nxglob=180 nyglob=150 blckx=15 blcky=150 mxblcks=1 io_type=PIO ^openmpi@4'
  - 'cice5@git.{{ ref }}=stable build_system=cmake model=access-om2 nxglob=180 nyglob=150 blckx=15 blcky=150 mxblcks=1 io_type=NetCDF ^openmpi@5'
  - 'cice5@git.{{ ref }}=stable build_type=Debug build_system=cmake model=access-om2 nxglob=180 nyglob=150 blckx=15 blcky=150 mxblcks=1'
  - 'cice5@git.{{ ref }}=stable model=access-om2'
  - 'access-om2 ^cice5@git.{{ ref }}=stable'
  packages:
    all:
      require:
      - '%access_oneapi'
  view: false
