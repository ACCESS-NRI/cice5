spack:
  include:
  # Include configuration from this repository, with the environment variable defined in build-ci
  - path: $SPACK_MANIFEST_REPOSITORY_PATH/.github/build-ci/config
  specs:
  - 'cice5@git.{{ ref }}=stable model=access-esm1.6 ^openmpi@4'
  - 'cice5@git.{{ ref }}=stable model=access-esm1.6 ^openmpi@5'
  - 'cice5@git.{{ ref }}=stable model=access-esm1.6 build_type=Debug'
  - 'cice5@git.{{ ref }}=stable model=access-esm1.6'
  - 'access-esm1p6 ^cice5@git.{{ ref }}=stable ^cable@2025.11.000 library=access-esm1.6'
  packages:
    # Unset inherited openmpi requirements from access-spack-packages so we can set our own in the spec list
    openmpi:
      require:: []
    all:
      require:
      - '%access_oneapi'
  view: false
