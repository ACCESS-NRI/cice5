spack:
  specs:
  - 'cice5@git.{{ ref }}=stable model=access-esm1.6 ^openmpi@4'
  - 'cice5@git.{{ ref }}=stable model=access-esm1.6 ^openmpi@5'
  - 'cice5@git.{{ ref }}=stable build_type=Debug model=access-esm1.6'
  - 'access-esm1p6 ^cice5@git.{{ ref }}=stable ^cable@2025.11.000 library=access-esm1.6'
  packages:
    intel-oneapi-compilers:
      require:
      - '{{ oneapi_compiler_ver }}'
    all:
      require:
      - '%access_oneapi'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false
