spack:
  specs:
  - 'cice5@git.{{ ref }}=stable model=access-om2 ^openmpi@4'
  - 'cice5@git.{{ ref }}=stable model=access-om2 ^openmpi@5'
  packages:
    intel-oneapi-compilers:
      require:
      - '{{ oneapi_compiler_ver }}'
    all:
      prefer:
      - '%access_oneapi'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false