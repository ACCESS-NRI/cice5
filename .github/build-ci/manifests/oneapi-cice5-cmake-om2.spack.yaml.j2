spack:
  specs:
  - 'cice5@git.{{ ref }}=stable {{ om2_1deg }} io_type=PIO ^openmpi@4'
  - 'cice5@git.{{ ref }}=stable {{ om2_1deg }} io_type=NetCDF ^openmpi@5'
  - 'cice5@git.{{ ref }}=stable build_type=Debug {{ om2_1deg }}'
  packages:
    intel-oneapi-compilers:
      require:
      - '{{ oneapi_compiler_ver }}'
    all:
      prefer:
      - '%access_oneapi'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false